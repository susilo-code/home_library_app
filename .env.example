# ══════════════════════════════════════════════════════════════════════
#  Hirunaza's Library Information System — Contoh Konfigurasi Lingkungan
#
#  CARA PAKAI:
#    1. Salin file ini menjadi ".env"  (atau jalankan setup.bat otomatis)
#    2. Sesuaikan nilainya bila perlu
#    3. File .env TIDAK ikut ter-commit ke GitHub (berisi rahasia)
# ══════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────
# SECRET_KEY: WAJIB diganti dengan nilai acak milik Anda sendiri.
# Buat yang baru dengan perintah:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=GANTI-DENGAN-SECRET-KEY-ACAK-ANDA-SENDIRI
# DEBUG=True hanya untuk pengembangan lokal. Set False untuk produksi.
DEBUG=True
# Pisahkan dengan koma, tanpa spasi.
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
TIME_ZONE=Asia/Jakarta

# ── Database ──────────────────────────────────────────────────────────
# Pilihan DB_ENGINE:  sqlite | mysql | postgres
#   sqlite    -> tanpa instalasi server, file DB_NAME dibuat otomatis  (paling aman untuk PC baru)
#   mysql     -> butuh PyMySQL (lihat requirements.txt) / Laragon
#   postgres  -> butuh psycopg (lihat requirements.txt)
DB_ENGINE=sqlite

# SQLite  : isi nama file, contoh: db.sqlite3
# MySQL   : isi nama database, contoh: hirunaza_library  (buat dulu di Laragon/phpMyAdmin)
# Postgres: isi nama database, contoh: hirunaza_library
DB_NAME=db.sqlite3

# Diabaikan bila DB_ENGINE=sqlite
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
# MySQL Laragon biasanya 3307, MySQL standar 3306, PostgreSQL 5432
DB_PORT=3307

# ── Alamat server lokal (dibaca oleh start.bat) ───────────────────────
DJANGO_PORT=8000
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

# ── Keamanan sesi ─────────────────────────────────────────────────────
# Keluar otomatis setelah SEKIAN MENIT tanpa aktivitas; pengguna harus login lagi.
# Menutup browser juga mengakhiri sesi. Kosongkan/ubah bila perlu.
SESSION_IDLE_MINUTES=10
